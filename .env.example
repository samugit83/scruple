# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Your key from console.typesafe.ai, or a Vercel AI Gateway key.
JEV_API_KEY=

# The System One endpoint. Override only if you are pointed at a proxy.
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone

# Model alias. Pin an exact version if published accuracy numbers must stay
# valid -- a model change invalidates them, and the run manifest records
# whichever version the API actually returned.
JEV_MODEL=typesafe-ai/jev

# Only needed for the comparison backends of §9.2.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
